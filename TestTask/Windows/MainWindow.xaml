<Window x:Class="TestTask.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connector" Height="450" Width="800">
    <Grid Background="#FF939A93">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="9*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="MainDataGrid" ItemsSource="{Binding Trades}" Grid.Row="1" Margin="5" AutoGenerateColumns="True" IsManipulationEnabled="True"/>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10">
            <Button Content="Показать баланс" Click="ShowBalance_Click"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="10">
            <Button Content="Получить трейды" Click="GetTrades_Click"/>
            <Button Content="Получить свечи" Click="GetCandles_Click"/>
            <Button Content="Получить тикер" Click="GetTicker_Click"/>
            <Button Content="Обновить" Click="Update_Click"/>
        </StackPanel>
    </Grid>
</Window>
