<Window x:Class="TestTask.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connector" Height="450" Width="800">
    <Grid Background="#FF939A93">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="9*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="MainDataGrid" Grid.Row="1" Margin="5" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Currency" Binding="{Binding CurrencyName}" />
                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" />
                <DataGridTextColumn Header="Amount in BTC" Binding="{Binding AmountInBTC, StringFormat=N2}" />
                <DataGridTextColumn Header="Amount in XPR" Binding="{Binding AmountInXPR, StringFormat=N2}" />
                <DataGridTextColumn Header="Amount in XMR" Binding="{Binding AmountInXMR, StringFormat=N2}" />
                <DataGridTextColumn Header="Amount in DASH" Binding="{Binding AmountInDASH, StringFormat=N2}" />
                <DataGridTextColumn Header="Amount in USD" Binding="{Binding AmountInUSD, StringFormat=N2}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel x:Name="TopStackPanel" Orientation="Horizontal" Grid.Row="0" Margin="10">
            <Label Content="Bitfinex"/>
        </StackPanel>

        <Label Content="RestAPI" Grid.Row="2" HorizontalAlignment="Left" Margin="2"/>
        <Label Content="WebSocketAPI" Grid.Row="2" HorizontalAlignment="Right" Margin="2"/>

        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="10">
            <Button Content="Получить трейды" Click="GetTrades_Click"/>
            <Button Content="Получить свечи" Click="GetCandles_Click"/>
            <Button Content="Получить тикер" Click="GetTicker_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="10" HorizontalAlignment="Right">
            <Button Content="Инф. о трейдах" Click="UpdatedTrades_Click"/>
            <Button Content="Инф. о свечах" Click="UpdatedCandles_Click"/>
        </StackPanel>
    </Grid>
</Window>
